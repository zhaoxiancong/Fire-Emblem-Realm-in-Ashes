# 山河烬 框架补丁: shanhe-ch2-eventscript
#
# 目标文件: src/events/ch2-eventscript.h
# 基线提交: ec1dc8553419c8833a687fd8d4a6521a4e29ff7a
#
# 修什么（1 处）:
#   `LOAD1(0x0, UnitDef_Event_Ch2Ally)` → `UnitDef_Shanhe02_Ally`。
#
# ⚠️ 同场景上方那条 `LOAD1(0x1, UnitDef_Ch2Ally)`（Vanessa 单人）**有意不动**：
#    它服务于紧随其后的 `CUMO_CHAR(CHARACTER_VANESSA)` 与 `MOVE(0x18,
#    CHARACTER_VANESSA, 2, 3)` —— 动它会让这两条指令失去目标单位而**卡住演出**。
#    这条「上游客串角色留着，但只留演出需要的那一个」是本章的最小改动口径。
#
# ★ 这也说明一件事：**替换单位组不是纯替换**，必须先把本章演出脚本引用到的角色
#   全列出来，逐个判断「演出目标会不会落空」。
#
# 依据: docs/4 §M4 硬门禁 1；docs/1 §4.5「第 2 章 · 山道问路」。
#

diff --git a/src/events/ch2-eventscript.h b/src/events/ch2-eventscript.h
--- a/src/events/ch2-eventscript.h
+++ b/src/events/ch2-eventscript.h
@@ -83,7 +83,7 @@
     SVAL(EVT_SLOT_2, EventScr_Ch2_1)
     CALL(EventScr_CallOnTutorialMode)
 
-    LOAD1(0x0, UnitDef_Event_Ch2Ally)
+    LOAD1(0x0, UnitDef_Shanhe02_Ally)
     ENUN
     CUMO_CHAR(CHARACTER_VANESSA)
     STAL(60)
