 extern CONST_DATA EventListScr EventScr_FloorClearInTower[];
 extern CONST_DATA EventListScr EventScr_WholeTowerClear[];
 
+/* 山河烬 · 序章（章节表通道生成 + 自家事件脚本）；实现见 src/shanhe_p_events.c */
+extern CONST_DATA EventListScr EventScr_ShanheP_BeginningScene[];
+extern CONST_DATA EventListScr EventScr_ShanheP_EndingScene[];
